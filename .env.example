# ---------------------------------------------------------------------------
# TEMPLATE -- this file IS committed to git. It contains no real secrets.
#
# To set up your own copy:
#     cp .env.example .env
# then open .env and paste your real key after ANTHROPIC_API_KEY=
#
# Why two files? Anyone cloning the repo needs to know WHICH settings exist
# without ever seeing your actual values.
# ---------------------------------------------------------------------------

# Your Claude API key, from https://console.anthropic.com/
# Not needed until Month 3 -- ingestion does not call the API.
ANTHROPIC_API_KEY=sk-ant-put-your-real-key-here

# Which Claude model to use.
CLAUDE_MODEL=claude-opus-5
